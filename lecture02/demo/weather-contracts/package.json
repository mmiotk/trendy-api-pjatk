{
  "name": "weather-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "mock": "prism mock contracts/openapi/weather.v1.yaml -p 4010",
    "generate": "npx --yes openapi-typescript@7.13.0 contracts/openapi/weather.v1.yaml -o src/generated/weather.v1.d.ts",
    "typecheck": "tsc --noEmit",
    "client": "node src/client.ts",
    "conformance": "node src/conformance.ts",
    "sdl": "node src/sdl.ts",
    "breaking": "oasdiff breaking --fail-on ERR contracts/openapi/weather.v1.yaml contracts/openapi/weather.v2.yaml && buf breaking contracts/proto-evolution/v2 --against contracts/proto-evolution/v1",
    "formats": "node src/formats.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "avsc": "^5.7.9",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "graphql": "^17.0.2",
    "js-yaml": "^5.4.2",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@asyncapi/cli": "^6.2.0",
    "@bufbuild/buf": "^1.73.0",
    "@oasdiff-js/oasdiff-js": "^1.0.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@asyncapi/cli@6.2.0": true,
    "@bufbuild/buf@1.73.0": true,
    "@hyperjump/json-pointer@0.9.8": true,
    "@hyperjump/json-schema@0.23.5": true,
    "@hyperjump/json-schema-core@0.28.5": true,
    "@hyperjump/pact@0.2.5": true,
    "@scarf/scarf@1.4.0": true,
    "yarn@1.22.22": true
  }
}
