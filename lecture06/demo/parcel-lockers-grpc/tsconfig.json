{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext", // moduły jak w Node.js
    "noEmit": true, // tsc tylko sprawdza typy
    "allowImportingTsExtensions": true, // import "./data.ts"
    "erasableSyntaxOnly": true, // tylko typy do wycięcia
    "verbatimModuleSyntax": true, // import type dla typów
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
